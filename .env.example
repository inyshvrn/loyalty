# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon/Supabase in production; local `npx prisma dev` for local dev)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js (NextAuth v5)
# AUTH_SECRET: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""
# AUTH_URL: the app's own base URL, used to build callback/verification links.
# Local dev: http://localhost:3000
# Production: set this once the app has a real deployment URL (see docs/authentication.md).
AUTH_URL="http://localhost:3000"

# Resend (email verification)
# Leave RESEND_API_KEY blank in local dev — the verification email flow falls
# back to logging the link to the server console instead of sending it.
RESEND_API_KEY=""
# Sender address. Resend's shared sandbox sender only delivers to your own
# Resend account email until you verify a domain — see docs/authentication.md.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Seed script overrides (optional). Without these, `npm run db:seed` creates
# obvious dev-only placeholder accounts — see docs/authentication.md.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_BARISTA_EMAIL=""
# SEED_BARISTA_PASSWORD=""
