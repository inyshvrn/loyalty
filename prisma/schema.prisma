// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

/// A physical shop location. Only meaningful for baristas (which outlet they
/// work at) and stamps (which outlet a scan happened at) — customers and
/// admins aren't tied to one.
model Outlet {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  baristas User[]  @relation("BaristaOutlet")
  stamps   Stamp[] @relation("StampOutlet")

  stampGrantRequests StampGrantRequest[] @relation("StampGrantRequestOutlet")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  phone         String?
  passwordHash  String
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  outletId      String?
  outlet        Outlet?  @relation("BaristaOutlet", fields: [outletId], references: [id])

  /// Reset to 0 on a successful login. Once it crosses the threshold in
  /// authorize(), lockedUntil is set and further attempts are rejected
  /// without even checking the password, until it passes.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  stampsReceived  Stamp[]       @relation("CustomerStamps")
  stampsScanned   Stamp[]       @relation("BaristaScannedStamps")
  claimsReceived  RewardClaim[] @relation("CustomerClaims")
  claimsConfirmed RewardClaim[] @relation("BaristaConfirmedClaims")
  claimsCancelled RewardClaim[] @relation("AdminCancelledClaims")

  stampGrantRequestsReceived  StampGrantRequest[] @relation("StampGrantRequestCustomer")
  stampGrantRequestsRequested StampGrantRequest[] @relation("StampGrantRequestRequestedBy")
  stampGrantRequestsReviewed  StampGrantRequest[] @relation("StampGrantRequestReviewedBy")
}

/// One row per QR scan. Current progress toward the threshold is derived —
/// count of a customer's Stamp rows since their last RewardClaim (or since
/// registration if none yet) — not stored directly. `outletId` is a snapshot
/// of the scanning barista's outlet at scan time (nullable: null for stamps
/// scanned before outlets existed, or by a barista with none assigned yet).
model Stamp {
  id                 String   @id @default(cuid())
  customerId         String
  customer           User     @relation("CustomerStamps", fields: [customerId], references: [id])
  scannedByBaristaId String
  scannedByBarista   User     @relation("BaristaScannedStamps", fields: [scannedByBaristaId], references: [id])
  outletId           String?
  outlet             Outlet?  @relation("StampOutlet", fields: [outletId], references: [id])
  createdAt          DateTime @default(now())

  @@index([customerId])
}

enum RewardClaimStatus {
  CONFIRMED
  CANCELLED
}

/// Written when a barista confirms a reward hand-off; this is what resets a
/// customer's stamp progress. Never hard-deleted — an admin can only cancel
/// a mistaken claim via status, so history stays permanent.
model RewardClaim {
  id                   String            @id @default(cuid())
  customerId           String
  customer             User              @relation("CustomerClaims", fields: [customerId], references: [id])
  confirmedByBaristaId String
  confirmedByBarista   User              @relation("BaristaConfirmedClaims", fields: [confirmedByBaristaId], references: [id])
  status               RewardClaimStatus @default(CONFIRMED)
  claimedAt            DateTime          @default(now())
  /// The cutoff the NEXT cycle's progress is counted from — normally the
  /// same moment as claimedAt, but if the customer had already earned one
  /// stamp beyond the threshold before this claim was confirmed (a delayed
  /// claim), it's backdated to the createdAt of the threshold-th stamp
  /// instead, so that one grace stamp still counts toward their next reward
  /// rather than being silently lost when progress resets.
  progressCutoffAt     DateTime
  cancelledAt          DateTime?
  cancelledByAdminId   String?
  cancelledByAdmin     User?             @relation("AdminCancelledClaims", fields: [cancelledByAdminId], references: [id])

  @@index([customerId])
}

/// Single-row config table — application code always reads/writes id 1.
model LoyaltySetting {
  id             Int      @id @default(1)
  stampThreshold Int      @default(7)
  updatedAt      DateTime @updatedAt
}

enum StampGrantStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A request to backfill several stamps at once for a customer's very first
/// visit — for someone transferring stamps from an old paper punch card who
/// self-registered instead of being migrated in by an admin. Only allowed
/// while the customer has zero Stamp rows ever (checked in the action, not
/// enforced here), so it can't become a backdoor for extra stamps later.
/// A barista-submitted request needs an admin's approval before the stamps
/// are actually created; an admin-submitted one is auto-approved (they don't
/// need to approve their own request) but still recorded here for the same
/// audit trail.
model StampGrantRequest {
  id                 String            @id @default(cuid())
  customerId         String
  customer           User              @relation("StampGrantRequestCustomer", fields: [customerId], references: [id])
  count              Int
  note               String?
  requestedByUserId  String
  requestedByUser    User              @relation("StampGrantRequestRequestedBy", fields: [requestedByUserId], references: [id])
  outletId           String?
  outlet             Outlet?           @relation("StampGrantRequestOutlet", fields: [outletId], references: [id])
  status             StampGrantStatus  @default(PENDING)
  createdAt          DateTime          @default(now())
  reviewedByAdminId  String?
  reviewedByAdmin    User?             @relation("StampGrantRequestReviewedBy", fields: [reviewedByAdminId], references: [id])
  reviewedAt         DateTime?

  @@index([customerId])
  @@index([status])
}
