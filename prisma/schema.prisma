// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

/// A physical shop location. Only meaningful for baristas (which outlet they
/// work at) and stamps (which outlet a scan happened at) — customers and
/// admins aren't tied to one.
model Outlet {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  baristas User[]  @relation("BaristaOutlet")
  stamps   Stamp[] @relation("StampOutlet")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  phone         String?
  passwordHash  String
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  outletId      String?
  outlet        Outlet?  @relation("BaristaOutlet", fields: [outletId], references: [id])

  /// Reset to 0 on a successful login. Once it crosses the threshold in
  /// authorize(), lockedUntil is set and further attempts are rejected
  /// without even checking the password, until it passes.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  stampsReceived  Stamp[]       @relation("CustomerStamps")
  stampsScanned   Stamp[]       @relation("BaristaScannedStamps")
  claimsReceived  RewardClaim[] @relation("CustomerClaims")
  claimsConfirmed RewardClaim[] @relation("BaristaConfirmedClaims")
  claimsCancelled RewardClaim[] @relation("AdminCancelledClaims")
}

/// One row per QR scan. Current progress toward the threshold is derived —
/// count of a customer's Stamp rows since their last RewardClaim (or since
/// registration if none yet) — not stored directly. `outletId` is a snapshot
/// of the scanning barista's outlet at scan time (nullable: null for stamps
/// scanned before outlets existed, or by a barista with none assigned yet).
model Stamp {
  id                 String   @id @default(cuid())
  customerId         String
  customer           User     @relation("CustomerStamps", fields: [customerId], references: [id])
  scannedByBaristaId String
  scannedByBarista   User     @relation("BaristaScannedStamps", fields: [scannedByBaristaId], references: [id])
  outletId           String?
  outlet             Outlet?  @relation("StampOutlet", fields: [outletId], references: [id])
  createdAt          DateTime @default(now())

  @@index([customerId])
}

enum RewardClaimStatus {
  CONFIRMED
  CANCELLED
}

/// Written when a barista confirms a reward hand-off; this is what resets a
/// customer's stamp progress. Never hard-deleted — an admin can only cancel
/// a mistaken claim via status, so history stays permanent.
model RewardClaim {
  id                   String            @id @default(cuid())
  customerId           String
  customer             User              @relation("CustomerClaims", fields: [customerId], references: [id])
  confirmedByBaristaId String
  confirmedByBarista   User              @relation("BaristaConfirmedClaims", fields: [confirmedByBaristaId], references: [id])
  status               RewardClaimStatus @default(CONFIRMED)
  claimedAt            DateTime          @default(now())
  cancelledAt          DateTime?
  cancelledByAdminId   String?
  cancelledByAdmin     User?             @relation("AdminCancelledClaims", fields: [cancelledByAdminId], references: [id])

  @@index([customerId])
}

/// Single-row config table — application code always reads/writes id 1.
model LoyaltySetting {
  id             Int      @id @default(1)
  stampThreshold Int      @default(7)
  updatedAt      DateTime @updatedAt
}
