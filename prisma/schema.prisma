// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

/// A physical shop location. Only meaningful for baristas (which outlet they
/// work at) and stamps (which outlet a scan happened at) — customers and
/// admins aren't tied to one.
model Outlet {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  baristas User[]  @relation("BaristaOutlet")
  stamps   Stamp[] @relation("StampOutlet")

  stampGrantRequests StampGrantRequest[] @relation("StampGrantRequestOutlet")
  referralCredits    ReferralCredit[]    @relation("ReferralCreditOutlet")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  phone         String?
  passwordHash  String
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  outletId      String?
  outlet        Outlet?  @relation("BaristaOutlet", fields: [outletId], references: [id])

  /// Reset to 0 on a successful login. Once it crosses the threshold in
  /// authorize(), lockedUntil is set and further attempts are rejected
  /// without even checking the password, until it passes.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  stampsReceived  Stamp[]       @relation("CustomerStamps")
  stampsScanned   Stamp[]       @relation("BaristaScannedStamps")
  claimsReceived  RewardClaim[] @relation("CustomerClaims")
  claimsConfirmed RewardClaim[] @relation("BaristaConfirmedClaims")
  claimsCancelled RewardClaim[] @relation("AdminCancelledClaims")

  stampGrantRequestsReceived  StampGrantRequest[] @relation("StampGrantRequestCustomer")
  stampGrantRequestsRequested StampGrantRequest[] @relation("StampGrantRequestRequestedBy")
  stampGrantRequestsReviewed  StampGrantRequest[] @relation("StampGrantRequestReviewedBy")

  /// Only ever set for role CUSTOMER — staff never get one. Generated once
  /// at account creation (self-registration or admin migration) and never
  /// changes.
  referralCode String? @unique
  /// The referrer whose code this user registered with, if any — captured
  /// once at registration and never changed afterward. A credit is only
  /// granted to referredBy once THIS user's email becomes verified (see
  /// ReferralCredit), not at raw registration.
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  referralCreditsEarned    ReferralCredit[] @relation("ReferrerCredits")
  referralCreditsFromMe    ReferralCredit[] @relation("ReferredUserCredits")
  referralCreditsRedeemed  ReferralCredit[] @relation("BaristaRedeemedCredits")
  referralCreditsCancelled ReferralCredit[] @relation("AdminCancelledReferralCredits")
}

/// One row per QR scan. Current progress toward the threshold is derived —
/// count of a customer's Stamp rows since their last RewardClaim (or since
/// registration if none yet) — not stored directly. `outletId` is a snapshot
/// of the scanning barista's outlet at scan time (nullable: null for stamps
/// scanned before outlets existed, or by a barista with none assigned yet).
model Stamp {
  id                 String   @id @default(cuid())
  customerId         String
  customer           User     @relation("CustomerStamps", fields: [customerId], references: [id])
  scannedByBaristaId String
  scannedByBarista   User     @relation("BaristaScannedStamps", fields: [scannedByBaristaId], references: [id])
  outletId           String?
  outlet             Outlet?  @relation("StampOutlet", fields: [outletId], references: [id])
  createdAt          DateTime @default(now())

  /// Set only for stamps created by a StampGrantRequest (initial/physical-card
  /// transfer) — lets an admin cancelling that request delete exactly these
  /// stamps and no others, even if the customer has since received more.
  grantRequestId String?
  grantRequest   StampGrantRequest? @relation(fields: [grantRequestId], references: [id])

  @@index([customerId])
  @@index([grantRequestId])
}

enum RewardClaimStatus {
  CONFIRMED
  CANCELLED
}

/// Written when a barista confirms a reward hand-off; this is what resets a
/// customer's stamp progress. Never hard-deleted — an admin can only cancel
/// a mistaken claim via status, so history stays permanent.
model RewardClaim {
  id                   String            @id @default(cuid())
  customerId           String
  customer             User              @relation("CustomerClaims", fields: [customerId], references: [id])
  confirmedByBaristaId String
  confirmedByBarista   User              @relation("BaristaConfirmedClaims", fields: [confirmedByBaristaId], references: [id])
  status               RewardClaimStatus @default(CONFIRMED)
  claimedAt            DateTime          @default(now())
  /// The cutoff the NEXT cycle's progress is counted from — normally the
  /// same moment as claimedAt, but if the customer had already earned one
  /// stamp beyond the threshold before this claim was confirmed (a delayed
  /// claim), it's backdated to the createdAt of the threshold-th stamp
  /// instead, so that one grace stamp still counts toward their next reward
  /// rather than being silently lost when progress resets.
  progressCutoffAt     DateTime
  cancelledAt          DateTime?
  cancelledByAdminId   String?
  cancelledByAdmin     User?             @relation("AdminCancelledClaims", fields: [cancelledByAdminId], references: [id])

  @@index([customerId])
}

/// Single-row config table — application code always reads/writes id 1.
model LoyaltySetting {
  id                    Int          @id @default(1)
  stampThreshold        Int          @default(7)
  /// Discount awarded per successful referral — snapshotted onto each
  /// ReferralCredit at the moment it's earned, so changing this later never
  /// retroactively alters a credit already earned but not yet redeemed.
  referralDiscountType  DiscountType @default(PERCENT)
  referralDiscountValue Int          @default(10)
  updatedAt             DateTime     @updatedAt
}

enum StampGrantStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A request to backfill several stamps at once for a customer's very first
/// visit — for someone transferring stamps from an old paper punch card who
/// self-registered instead of being migrated in by an admin. Only allowed
/// while the customer has zero Stamp rows ever (checked in the action, not
/// enforced here), so it can't become a backdoor for extra stamps later.
/// The stamps are created immediately when a barista submits this (so the
/// customer's progress reflects it right away) — PENDING here means "awaiting
/// an admin's review of the physical card," not "not yet applied." An admin
/// approving it is just a sign-off; rejecting it deletes the linked Stamp
/// rows (see Stamp.grantRequestId). An admin-submitted grant skips the
/// review step entirely (stored pre-APPROVED) since they don't need to
/// approve their own request, but is still recorded here for the same audit
/// trail.
model StampGrantRequest {
  id                String           @id @default(cuid())
  customerId        String
  customer          User             @relation("StampGrantRequestCustomer", fields: [customerId], references: [id])
  count             Int
  note              String?
  requestedByUserId String
  requestedByUser   User             @relation("StampGrantRequestRequestedBy", fields: [requestedByUserId], references: [id])
  outletId          String?
  outlet            Outlet?          @relation("StampGrantRequestOutlet", fields: [outletId], references: [id])
  status            StampGrantStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  reviewedByAdminId String?
  reviewedByAdmin   User?            @relation("StampGrantRequestReviewedBy", fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?
  stamps            Stamp[]

  @@index([customerId])
  @@index([status])
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReferralCreditStatus {
  AVAILABLE
  REDEEMED
  CANCELLED
}

/// One discount credit earned by a customer (the referrer) when a friend
/// they referred becomes email-verified — mirrors the emailVerified gate
/// already used for barista stamping, so an unverified signup can't farm
/// credits. Credits never combine: each successful referral produces its
/// own row, and a barista can redeem exactly one per visit (the oldest
/// AVAILABLE one, FIFO). discountType/discountValue are snapshotted from
/// LoyaltySetting at the moment the credit is earned, so a later admin
/// change to the global referral discount never retroactively changes an
/// already-earned, unredeemed credit. Never hard-deleted — same
/// status-based correction pattern as RewardClaim, since a redeemed credit
/// represents a discount already given away, not a mistake to erase.
/// status has three real transitions: AVAILABLE -> REDEEMED (barista spends
/// it), REDEEMED -> AVAILABLE (admin corrects a mistaken redemption —
/// clears the redemption fields, cancelledAt/cancelledByAdminId become a
/// pure "this was corrected" audit marker), and AVAILABLE -> CANCELLED (an
/// admin permanently voids an unredeemed credit, e.g. suspected fraud —
/// terminal, never spendable again).
model ReferralCredit {
  id             String               @id @default(cuid())
  referrerId     String
  referrer       User                 @relation("ReferrerCredits", fields: [referrerId], references: [id])
  /// The referred friend whose email verification earned this credit — kept
  /// for audit/traceability even though the credit itself belongs to the
  /// referrer. @unique so a race on the verify-email link can never mint
  /// two credits for the same referred friend.
  referredUserId String               @unique
  referredUser   User                 @relation("ReferredUserCredits", fields: [referredUserId], references: [id])
  discountType   DiscountType
  discountValue  Int
  status         ReferralCreditStatus @default(AVAILABLE)
  createdAt      DateTime             @default(now())

  redeemedAt          DateTime?
  redeemedByBaristaId String?
  redeemedByBarista   User?     @relation("BaristaRedeemedCredits", fields: [redeemedByBaristaId], references: [id])
  outletId            String?
  outlet              Outlet?   @relation("ReferralCreditOutlet", fields: [outletId], references: [id])

  /// Set by either correction action below — the only permanent trace that
  /// a correction happened, and by whom. See the model doc comment above
  /// for what each status transition means.
  cancelledAt        DateTime?
  cancelledByAdminId String?
  cancelledByAdmin   User?     @relation("AdminCancelledReferralCredits", fields: [cancelledByAdminId], references: [id])

  @@index([referrerId])
}
